{
  "name": "@luxwallet/electron-chrome-extensions",
  "version": "3.9.13-alpha.0",
  "description": "Chrome extension support for Electron",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && webpack",
    "test": "node ./script/spec-runner.js"
  },
  "keywords": [
    "electron",
    "chrome",
    "extensions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxfi/electron-desktop-shell.git"
  },
  "author": "Samuel Maddock <sam@samuelmaddock.com>",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/debug": "^4.1.13",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/chrome": "^0.2.7",
    "@types/mocha": "^10.0.10",
    "babel-loader": "^10.1.1",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "colors": "^1.4.0",
    "electron": "^44.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2",
    "uuid": "^14.0.2",
    "walkdir": "^0.4.1",
    "webpack": "^5.110.1",
    "webpack-cli": "^7.2.3"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "electron": "10.1.0"
          }
        }
      ],
      "@babel/preset-typescript"
    ],
    "plugins": [
      [
        "@babel/plugin-proposal-class-properties",
        {
          "loose": true
        }
      ],
      "@babel/plugin-proposal-optional-chaining",
      [
        "@babel/plugin-proposal-private-property-in-object",
        {
          "loose": true
        }
      ]
    ]
  },
  "types": "./dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/luxfi/electron-desktop-shell/issues"
  },
  "homepage": "https://github.com/luxfi/electron-desktop-shell#readme"
}
